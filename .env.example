# ===================================================
# Moss Nexus - Environment Configuration
# 이 파일을 복사하여 .env 파일을 생성하세요
# cp .env.example .env
# ===================================================

# Discord Bot Token
# Discord Developer Portal에서 발급받은 봇 토큰
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord Allowlist (권장)
# 봇을 허용할 서버(guild)·채널 ID (쉼표 구분, 비우면 제한 없음)
DISCORD_GUILD_IDS=
DISCORD_CHANNEL_IDS=
# 사용자별 질의 쿨다운 (초) — /ask, /search 공통
DISCORD_COOLDOWN_SECONDS=30

# Ollama Configuration
# Ollama 서버 주소 (로컬 실행 시 기본값 사용)
OLLAMA_BASE_URL=http://localhost:11434
# 기본: qwen3.5:9b (6.6GB) / 더 좋은 품질: qwen3.5:27b (17GB)
OLLAMA_MODEL=qwen3.5:9b

# Qdrant Configuration
# Qdrant Vector DB 설정 (docker-compose 기본값은 127.0.0.1 바인드)
QDRANT_HOST=localhost
QDRANT_PORT=6333
# 실제 컬렉션은 이 alias 뒤에서 원자적으로 교체됩니다
QDRANT_COLLECTION_NAME=moss_knowledge

# Embedding Model Configuration
# HuggingFace 임베딩 모델 (dense+sparse 하이브리드 지원)
EMBEDDING_MODEL=BAAI/bge-m3
# auto: cuda → mps → cpu 순 자동 선택
EMBEDDING_DEVICE=auto

# Data Directory
# 문서 파일이 저장된 디렉토리 경로 (git에서 무시됨)
DATA_DIR=./data

# Chunking Configuration
# 문서 분할 설정
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Retrieval Configuration
# 답변 근거로 사용할 최종 문서 수
TOP_K_RESULTS=4
# dense 검색 최소 코사인 유사도 (이 값 미만은 근거로 사용하지 않음)
MIN_DENSE_SCORE=0.35

# FastAPI Configuration
# 기본은 루프백 — 외부 공개는 reverse proxy/TLS/Tailscale 뒤에서만 하세요
API_HOST=127.0.0.1
API_PORT=8000
# 동시 질의 제한 (로컬 LLM 보호)
MAX_CONCURRENT_QUERIES=2
QUERY_TIMEOUT_SECONDS=180

# Logging
# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
# 주의: 질문 원문·사용자명은 레벨과 무관하게 로그에 남기지 않습니다
LOG_LEVEL=INFO
