# ===================================================
# Moss Nexus - Git Ignore
# ===================================================

# Environment
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log

# Qdrant Storage (Docker volume)
qdrant_storage/

# Data — 내부 문서가 실수로 커밋되지 않도록 기본 무시
# (샘플 문서는 fixtures/ 에서 관리합니다. data/에는 README도 두지 않습니다 —
#  ingest가 data/의 모든 .md를 색인하기 때문)
data/*
!data/.gitkeep

# HuggingFace Cache
.cache/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/
